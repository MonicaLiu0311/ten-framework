# Example Environment Variables for Bisheng AI Integration
# Copy this file to ai_agents/.env and fill in your actual values

# ====================================
# STT Configuration - Speech-to-Text
# ====================================

# Deepgram (Recommended for English)
DEEPGRAM_API_KEY=

# Alternative STT services (uncomment to use):
# AZURE_ASR_KEY=
# BYTEDANCE_ASR_KEY=
# BYTEDANCE_ASR_APPID=
# XFYUN_ASR_KEY=

# ====================================
# TTS Configuration - Text-to-Speech
# ====================================

# ElevenLabs (Recommended for English)
ELEVENLABS_TTS_KEY=

# Alternative TTS services (uncomment to use):
# AZURE_TTS_KEY=
# BYTEDANCE_TTS_KEY=
# BYTEDANCE_TTS_APPID=
# FISH_AUDIO_TTS_KEY=

# ====================================
# Bisheng AI Configuration (Required)
# ====================================

# Your Bisheng AI service endpoint URL
BISHENG_AI_URL=https://your-bisheng-ai-domain.com/api/v1/chat

# Optional: API key if your Bisheng AI requires authentication
BISHENG_AI_API_KEY=

# Choose ONE mode (assistant or workflow):
# Mode 1: Assistant mode
BISHENG_AI_ASSISTANT_ID=

# Mode 2: Workflow mode
BISHENG_AI_WORKFLOW_ID=

# Note: If both are provided, assistant mode takes priority

# ====================================
# Optional Configuration
# ====================================

# Language for speech recognition (default: "en-US")
# Set to "zh-CN" for Chinese
# STT_LANGUAGE=zh-CN

# Timeout for Bisheng AI requests in seconds (default: 30)
# BISHENG_AI_TIMEOUT=30
